{
  "name": "foto-booth",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.x",
    "pnpm": ">=9.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @foto-booth/api start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "node e2e/phase5-upload.e2e.mjs",
    "test:e2e:filters": "node e2e/phase6-filters.e2e.mjs",
    "test:e2e:leads": "node e2e/phase9-leads.e2e.mjs",
    "test:e2e:license": "node e2e/phase10-license.e2e.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "playwright": "1.64.0",
    "typescript-eslint": "^8.23.0"
  }
}
